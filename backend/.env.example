# Copy to .env locally and load with uvicorn --env-file .env (not committed).
LUNARIDGE_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production requires your genuine application contact; this placeholder is rejected.
NASA_USER_AGENT=LunaRIDGE/0.5.0 (REPLACE_WITH_YOUR_PUBLIC_CONTACT)
# Optional absolute persistent-disk path. Blank uses repository data/lunar_dem/.
DEM_PATH=
DEM_STRATEGY=existing
PORT=8000
MAX_SAMPLES=2000
MAX_MISSION_HOURS=720
MAX_TERRAIN_SAMPLES=1000000
MAX_BODY_BYTES=4000000
REQUESTS_PER_IP_MINUTE=120
REQUESTS_GLOBAL_MINUTE=600
SCIENCE_PER_IP_MINUTE=12
SCIENCE_GLOBAL_MINUTE=30
WEB_CONCURRENCY=1
